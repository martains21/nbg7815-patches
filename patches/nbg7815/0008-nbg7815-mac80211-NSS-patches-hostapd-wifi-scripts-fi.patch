++	u32 aifsn[WMI_AC_MAX];
++	u32 ecwmin[WMI_AC_MAX];
++	u32 ecwmax[WMI_AC_MAX];
++	u32 muedca_expiration_time[WMI_AC_MAX];
++} __packed;
++
