++	mutex_lock(&ar->conf_mutex);
++
++	reinit_completion(&arvif->nss.dump_mpp_complete);
++
++	priv_data = kzalloc(sizeof(*priv_data), GFP_KERNEL);
++	if (!priv_data) {
++		mutex_unlock(&ar->conf_mutex);
++		return -ENOMEM;
++	}
++
++	priv_data->arvif = arvif;
