++		if (ret) {
++			ath11k_warn(ar->ab, "failed to queue qos null frame %d\n",
++				    ret);
++			ieee80211_free_txskb(ar->hw, skb);
++		}
++		return;
+ 	}
+ 
+ 	if (control->sta)
