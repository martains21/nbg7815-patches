++		ath11k_warn(ar->ab, "failed to send dump mpp command %d\n", ret);
++		goto err_unlock;
++	}
++
++	time_left = wait_for_completion_timeout(&arvif->nss.dump_mpp_complete,
++						ATH11K_NSS_MPATH_DUMP_TIMEOUT);
++	if (time_left == 0) {
++		ret = -ETIMEDOUT;
++		goto err_unlock;
