++		retry_limit          : 4,
++		use_dcm_11ax         : 1,
++		ltf_subtype_11ax     : 2,
++		dyn_bw               : 1,
++		bw_mask              : 6,
++		host_tx_desc_pool    : 1;
++	u32
++		power                : 8,
++		mcs_mask             : 12,
++		nss_mask             : 8,
++		pream_type           : 3,
++		update_peer_cache    : 1;
++	u32
++		chain_mask         : 8,
