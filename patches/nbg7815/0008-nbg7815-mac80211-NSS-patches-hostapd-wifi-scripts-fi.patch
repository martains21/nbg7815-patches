+ 	ath11k_dbg(ab, ATH11K_DBG_MAC, "ath11k_peer_del_ast pdev:%d peer %pM ast_entry %pM\n",
+ 		   ar->pdev->pdev_id, peer->addr, ast_entry->addr);
+ 
+-	if (ast_entry->is_mapped)
